# Copia este archivo como ".env" (no se sube a GitHub) y cambia los valores.
# docker compose lo lee solo.

# Contraseña de PostgreSQL
DB_PASSWORD=vet123

# Clave para firmar los tokens JWT (mínimo 32 caracteres, inventa una larga)
JWT_SECRETO=cambia-esta-clave-por-una-larga-y-secreta-2026

# Páginas que pueden llamar a la API (separadas por coma, sin espacios)
CORS_ORIGENES=http://localhost:5173,http://localhost:4173,https://briveraac.github.io
